# Local secrets. Copy .env.example to .env for local runs, but never commit .env.
.env*

# Runtime logs are generated while starting services or running tests.
logs/

# Python bytecode and cache directories are generated artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# IDE project metadata is local to the developer machine.
.idea/

# Private application data, local verification artifacts and environments.
data/
.test-runs/
.venv/
artifacts/
*.sqlite3*
*.pem
*.key
.vscode/
