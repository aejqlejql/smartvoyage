LLM_MODEL_NAME=qwen-plus
SMARTVOYAGE_DB_HOST=127.0.0.1
SMARTVOYAGE_DB_PORT=3306
SMARTVOYAGE_DB_USER=root
SMARTVOYAGE_DB_PASSWORD=
